# Environment Configuration Template
PROJECT_NAME="AI-Assisted Vendor Risk Classification and Trust Assessment System"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/vendor_risk_db
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/vendor_risk_db

# Fallback test database URL (optional, defaults to SQLite if Postgres unavailable during testing)
# TEST_DATABASE_URL=sqlite:///./test_vendor_risk.db

# API Settings
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
